# StudioOS LIVE settings. Copy to .env.live on the NAS and fill in every value.
# Keep this file private: it holds passwords. Never send it in chat or email.

STUDIOOS_ENV=production
STUDIOOS_VERSION=0.16.12
APP_PORT=8000

# Database password: long and random (at least 24 characters).
DB_PASSWORD=
# v0.16.1: the app's own database login. It owns nothing, so it cannot switch off the ledger
# rules. Required for live data. Use a DIFFERENT long password (16+ characters; letters, digits,
# - and _ only, because it goes into a connection address).
STUDIOOS_APP_DB_USER=studioos_app
STUDIOOS_APP_DB_PASSWORD=
STUDIOOS_DB_ROLE=app
# Admin sign-in: at least 16 characters. Two-factor setup is required at first sign-in.
STUDIOOS_ADMIN_USERNAME=admin
STUDIOOS_ADMIN_PASSWORD=
STUDIOOS_REQUIRE_ADMIN_2FA=true

# Folders on the NAS host (absolute paths). Examples are for Synology; adjust for yours.
# BACKUP_PATH: backups on the NAS itself.
BACKUP_PATH=/volume1/studioos/live/backups
# OFFSITE_PATH: MUST be outside the NAS: a USB drive plugged into the NAS, a second NAS,
# or a folder your cloud sync (Synology Cloud Sync, Google Drive, OneDrive) uploads.
OFFSITE_PATH=/volumeUSB1/usbshare/studioos-live-copies
# Your project files (read-only to StudioOS).
NAS_PROJECTS_PATH=/volume1/projects
# v0.9.1: photos and files people attach in the chat (kept on the NAS, copied with every backup).
FILES_PATH=/volume1/studioos/live/files

# Backups every 6 hours; automatic restore test every 24 hours.
STUDIOOS_BACKUP_EVERY_HOURS=6
STUDIOOS_RESTORE_DRILL_EVERY_HOURS=24

# Must be true for live data (v0.9.2): StudioOS refuses to start otherwise. Serve it over
# HTTPS with `tailscale serve` (see RUNBOOK.md). Sign-in cookies are then never sent unencrypted.
STUDIOOS_SECURE_COOKIE=true
STUDIOOS_IDLE_MINUTES=30

# Real AI stays OFF until the live benchmark and hold-out tests pass.
STUDIOOS_PROVIDER=demo
STUDIOOS_ALLOW_LIVE_AI=false
STUDIOOS_DAILY_USD_CAP=1.00
# When you turn AI on, fill these from the provider's official price page:
STUDIOOS_RATE_MODEL=
STUDIOOS_INPUT_USD_PER_1M=
STUDIOOS_OUTPUT_USD_PER_1M=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# v0.9.3: AI connector (MCP) so Claude or ChatGPT can read StudioOS for you. Off by default.
# Read RUNBOOK.md "AI connector" before turning it on. Try it on the TEST copy first.
STUDIOOS_MCP_ENABLED=false
# Addresses allowed to call /mcp (comma-separated, CIDR). Use the AI provider's published ranges.
STUDIOOS_MCP_ALLOWED_IPS=
# The public connector address exactly as requests arrive (host:port), e.g. nas-name.tailnet.ts.net:8443.
# On that address only /mcp exists; everything else answers "not found".
STUDIOOS_PUBLIC_HOST=
STUDIOOS_MCP_MAX_PER_MINUTE=60

# v0.14.0 Inbox. Files that arrive are kept here (on the NAS, backed up with FILES_PATH).
STUDIOOS_INTAKE_DIR=/volume1/studioos/live/files/intake
# WhatsApp Business (Cloud API) webhook: leave empty to keep WhatsApp intake OFF.
STUDIOOS_WHATSAPP_APP_SECRET=
STUDIOOS_WHATSAPP_VERIFY_TOKEN=
# E-mail intake (a mailbox only for StudioOS). Leave empty to keep it OFF.
STUDIOOS_IMAP_HOST=
STUDIOOS_IMAP_USER=
STUDIOOS_IMAP_PASSWORD=
STUDIOOS_IMAP_FOLDER=INBOX

# v0.15.0 Scheduler: daily rules, e-mail, summaries and weekly suggestions (on unless set to off).
STUDIOOS_SCHEDULER=on
STUDIOOS_JOBS_HOUR=7
STUDIOOS_TZ_OFFSET_MINUTES=330
# Summaries by e-mail (optional). Leave empty to keep summaries inside StudioOS only.
STUDIOOS_SMTP_HOST=
STUDIOOS_SMTP_PORT=587
STUDIOOS_SMTP_USER=
STUDIOOS_SMTP_PASSWORD=
STUDIOOS_SMTP_FROM=
