# StudioOS TEST copy settings. Copy to .env.test on the NAS.
# The test copy is where new versions and changes are tried first, on a MASKED
# copy of live data. It has its own database, backups and port.

STUDIOOS_ENV=test
STUDIOOS_VERSION=0.28.0
APP_PORT=8001

# Use DIFFERENT passwords from live.
DB_PASSWORD=
# v0.16.1: the app's own database login. It owns nothing, so it cannot switch off the ledger
# rules. Required for live data. Use a DIFFERENT long password (16+ characters; letters, digits,
# - and _ only, because it goes into a connection address).
STUDIOOS_APP_DB_USER=studioos_app
STUDIOOS_APP_DB_PASSWORD=
STUDIOOS_DB_ROLE=app
STUDIOOS_ADMIN_USERNAME=admin
STUDIOOS_ADMIN_PASSWORD=
STUDIOOS_REQUIRE_ADMIN_2FA=false

BACKUP_PATH=/volume1/studioos/test/backups
# Test backups can stay on the NAS, but the setting is still required.
OFFSITE_PATH=/volume1/studioos/test/backups-second-copy
# The LIVE backup folder, read-only, used to build the masked test copy.
LIVE_BACKUP_PATH=/volume1/studioos/live/backups
NAS_PROJECTS_PATH=/volume1/projects
# v0.9.1: photos and files people attach in the chat (kept on the NAS, copied with every backup).
FILES_PATH=/volume1/studioos/test/files

STUDIOOS_BACKUP_EVERY_HOURS=24
STUDIOOS_RESTORE_DRILL_EVERY_HOURS=72

STUDIOOS_PROVIDER=demo
STUDIOOS_ALLOW_LIVE_AI=false
STUDIOOS_DAILY_USD_CAP=0.50

# v0.9.3: AI connector (MCP) so Claude or ChatGPT can read StudioOS for you. Off by default.
# Read RUNBOOK.md "Test the public connector address" before turning it on. Try it on the TEST copy first.
STUDIOOS_MCP_ENABLED=false
# Addresses allowed to call /mcp (comma-separated, CIDR). Use the AI provider's published ranges.
STUDIOOS_MCP_ALLOWED_IPS=
# The public connector address exactly as requests arrive (host:port), e.g. nas-name.tailnet.ts.net:8443.
# Route that address to the optional connector service. Its port serves only /mcp.
STUDIOOS_CONNECTOR_PORT=8003
STUDIOOS_PUBLIC_HOST=
STUDIOOS_MCP_MAX_PER_MINUTE=60
