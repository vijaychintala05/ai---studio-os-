  {
   "key": "purchase",
   "title": "Purchase of material or services",
   "triggers": [
    "bought",
    "purchased",
    "purchase",
    "procured",
    "received bill",
    "bill from",
    "supplied"
   ],
   "needs": [
    "amount",
    "item"
   ],
   "party_word": "from",
   "default_settlement": "credit",
   "narration": "Purchase: {quantity}{item}{from_party}",
   "lines": [
    {
     "account": {
      "find": "item",
      "under": "DIRECT_COSTS",
      "also_under": "INDIRECT_EXPENSES",
      "create_under": "DIRECT_MATERIAL"
     },
     "side": "debit",
     "amount": "taxable"
    },
    {
     "account": {
      "code": "INPUT_CGST"
     },
     "side": "debit",
     "amount": "cgst"
    },
    {
     "account": {
      "code": "INPUT_SGST"
     },
     "side": "debit",
     "amount": "sgst"
    },
    {
     "account": {
      "code": "INPUT_IGST"
     },
     "side": "debit",
     "amount": "igst"
    },
    {
     "account": {
      "settle": {
       "credit": {
        "find": "party",
        "under": "SUNDRY_CREDITORS",
        "create_under": "SUNDRY_CREDITORS"
       },
       "cash": {
        "code": "CASH"
       },
       "bank": {
        "role": "bank"
       }
      }
     },
     "side": "credit",
     "amount": "total"
    }
   ]
  },
