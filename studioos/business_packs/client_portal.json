{
  "key": "client_portal",
  "title": "Client portal deliverables",
  "version": 1,
  "description": "Drawings, renders and other files you choose to share with a client. A client sees an item only when it is marked Final and shared with the client; you can also ask them to approve it.",
  "types": [
    {
      "key": "client_deliverable",
      "title": "Client deliverable",
      "aliases": [
        "client file",
        "shared drawing",
        "final render"
      ],
      "label_field": "title",
      "approver_roles": [
        "manager"
      ],
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true,
          "meaning": "Title the client will see"
        },
        {
          "name": "kind",
          "type": "enum",
          "required": true,
          "meaning": "Kind",
          "options": [
            "Drawing",
            "Render",
            "Material selection",
            "Report",
            "Other"
          ]
        },
        {
          "name": "file",
          "type": "reference",
          "target": "system.document",
          "required": true,
          "meaning": "File"
        },
        {
          "name": "release",
          "type": "enum",
          "required": true,
          "meaning": "Release",
          "options": [
            "Draft",
            "Final",
            "Superseded"
          ]
        },
        {
          "name": "shared_with_client",
          "type": "boolean",
          "required": true,
          "meaning": "Share with the client (they see it only when Final and shared)"
        },
        {
          "name": "note_for_client",
          "type": "text",
          "required": false,
          "meaning": "Short note the client will see"
        },
        {
          "name": "needs_client_approval",
          "type": "boolean",
          "required": false,
          "meaning": "Ask the client to approve this (they can approve or ask for changes)"
        }
      ]
    }
  ],
  "relations": [],
  "views": [],
  "reports": [],
  "workflows": []
}
